            <Textbox Name="txtFooter"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Cảm ơn Quý khách &amp; Chúc Quý khách sức khỏe! (Trang </Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun><TextRun><Value>=Globals!PageNumber &amp; "/" &amp; Globals!TotalPages &amp; ")"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Top>0.15in</Top><Left>0.05in</Left><Height>0.3in</Height><Width>6.9in</Width></Textbox>
